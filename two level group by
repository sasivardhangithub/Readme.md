ELECT cust_gender, cust_marital_status, COUNT(*) AS total_customers FROM sh.customers GROUP BY cust_gender, cust_marital_status;

SELECT prod_category, prod_subcategory, COUNT(*) AS Number_of_products FROM sh.products GROUP BY prod_category, prod_subcategory;

SELECT prod_id, channel_id, SUM(amount_sold) AS total_sales_amount FROM sh.sales GROUP BY prod_id, channel_id;

SELECT channel_id, promo_id, SUM(quantity_sold) AS total_quantity_sold FROM sh.sales GROUP BY channel_id, promo_id;

SELECT prod_id, promo_id, AVG(unit_cost) AS avg_unit_cost FROM sh.costs GROUP BY prod_id, promo_id;
